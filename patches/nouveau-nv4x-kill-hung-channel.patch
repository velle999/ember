Subject: drm/nouveau: declare a channel dead when its fences stop retiring

--- a/drivers/gpu/drm/nouveau/nouveau_fence.c
+++ b/drivers/gpu/drm/nouveau/nouveau_fence.c
@@ -271,9 +271,54 @@
 
 		t = jiffies;
 
-		if (wait != MAX_SCHEDULE_TIMEOUT && time_after_eq(t, timeout)) {
+		/*
+		 * THE ENGINE IS DEAD — DECLARE THE CHANNEL DEAD TOO.
+		 *
+		 * Measured on nv4x (G73): once the graphics engine faults, no
+		 * fence ever retires again. 790 deadline hits, done=0 every
+		 * time, 760 of them on Xorg's channel. The waits reaching this
+		 * point are long — 698 at cpu_prep's 30 s and 78 at
+		 * MAX_SCHEDULE_TIMEOUT from nouveau_bo_move — so userspace sits
+		 * here, times out, retries, forever. The desktop is livelocked,
+		 * not deadlocked, which is why X keeps answering non-GL clients
+		 * while every GL request hangs.
+		 *
+		 * nouveau already knows how to recover: nouveau_channel_killed()
+		 * sets chan->killed and calls nouveau_fence_context_kill(), and
+		 * pushbuf then returns -ENODEV so the client dies cleanly. That
+		 * path is driven by a FIFO notification which never arrives on
+		 * this chip. Pull the lever on a timeout instead.
+		 *
+		 * ⚠ EVERYTHING TOUCHING chan STAYS INSIDE THE RCU SECTION. An
+		 * earlier revision used chan->fence after rcu_read_unlock().
+		 */
+		if (time_after_eq(t, fence->timeout)) {
+			struct nouveau_channel *chan;
+			int chid = -1;
+
+			rcu_read_lock();
+			chan = rcu_dereference(fence->channel);
+			/*
+			 * ⛔ DO NOT CALL nouveau_fence_context_kill() HERE.
+			 * nouveau_channel_killed() does, but it runs from an
+			 * nvif notify callback — a different context. Called
+			 * from inside the wait it re-enters fctx->lock and
+			 * walks the pending list mid-mutation: NULL deref at
+			 * 0x4 after ~60 firings.
+			 *
+			 * Setting chan->killed is enough. pushbuf already
+			 * checks it and returns -ENODEV, and returning -ENODEV
+			 * here unblocks the current waiter.
+			 */
+			if (chan && !atomic_xchg(&chan->killed, 1))
+				chid = chan->chid;
+			rcu_read_unlock();
+
+			if (chid >= 0)
+				pr_err("nouveau: channel %d stopped retiring fences - marking it dead\n",
+				       chid);
 			__set_current_state(TASK_RUNNING);
-			return 0;
+			return -ENODEV;
 		}
 
 		__set_current_state(intr ? TASK_INTERRUPTIBLE :

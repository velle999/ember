Subject: drm/nouveau: add nouveau.accel_move= to take the GPU out of TTM buffer moves

--- a/drivers/gpu/drm/nouveau/nouveau_bo.c
+++ b/drivers/gpu/drm/nouveau/nouveau_bo.c
@@ -988,6 +988,10 @@
 	return ret;
 }
 
+int nouveau_accel_move = 1;
+module_param_named(accel_move, nouveau_accel_move, int, 0400);
+MODULE_PARM_DESC(accel_move, "use the GPU for TTM buffer moves (default: 1)");
+
 void
 nouveau_bo_move_init(struct nouveau_drm *drm)
 {
@@ -1060,6 +1064,26 @@
 		}
 	} while ((++mthd)->exec);
 
+	/*
+	 * nouveau.accel_move=0 forces TTM buffer moves through ttm_bo_move_memcpy()
+	 * instead of the GPU. On nv4x the accelerated path runs M2MF on the
+	 * drivers OWN channel (drm->channel), so every VRAM eviction becomes GPU
+	 * work on a low-numbered kernel channel -- and those are exactly the
+	 * channels observed dying here, during eviction storms, with no error
+	 * reported anywhere. Setting this to 0 removes the kernel channel from the
+	 * eviction path: slower, but it isolates whether the stall lives in buffer
+	 * moves or in rendering.
+	 */
+	if (!nouveau_accel_move) {
+		if (drm->ttm.move) {
+			nvif_object_dtor(&drm->ttm.copy);
+			drm->ttm.move = NULL;
+			drm->ttm.chan = NULL;
+		}
+		NV_INFO(drm, "MM: accel_move=0, CPU memcpy for buffer copies\n");
+		return;
+	}
+
 	NV_INFO(drm, "MM: using %s for buffer copies\n", name);
 }
 

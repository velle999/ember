#!/bin/sh
#
# ember-gpu — choose the graphics stack, and say what is running now.
#
# ── What this does and does not do ─────────────────────────────────────────
#
# ⛔ IT WRITES A PREFERENCE AND REBOOTS. It does not switch a running system.
# An earlier version did: it stopped lightdm, swapped the kernel module and
# started a second X server by hand. That worked, and produced a desktop with no
# seat, which made polkit demand a password for reboot, shutdown and suspend --
# see installer/ember-xserver for the measurement. Letting lightdm start the
# right server on the next boot is what makes the session a real one.
#
# The choice is applied at boot by 08-ember-gpu.sh, through ember-gpu-detect
# (which decides) and ember-gpu-apply (which loads the module).
#
# Usage:
#   ember-gpu                 show what is running and what is configured
#   ember-gpu auto            detect from the hardware (the default)
#   ember-gpu nvidia          force the proprietary 304 stack
#   ember-gpu nouveau         force the open driver
#   ember-gpu radeon|intel    force those (they are the autodetected default)
#
# ⚠ ON AN NVIDIA CARD, auto MEANS PROPRIETARY. 304 is chosen whenever the card
# is in its supported list, because on this hardware it is the better driver:
# measurably faster, and without the intermittent drawing artefacts nouveau
# shows on nv4x. nouveau is the fallback, not the default.
#
# ⛔ AND 304 ARMS A KERNEL BUG. nvidia.ko is unsigned and out-of-tree, and on
# this hardware that is the condition where reading /proc/modules NULL-derefs in
# m_show. While it is loaded:
#
#     * `lsmod` kills the machine
#     * anything that invokes dracut kills the machine -- INCLUDING A KERNEL
#       UPGRADE, which now happens on a machine that boots this way by default
#
# ⚠ TWO WAYS OUT, NEITHER NEEDING A DESKTOP. At the GRUB menu press `e` and
# append ember.gpu=nouveau to the linux line — that works when nothing but the
# bootloader does. Or log in on a text console (tty1-6 are always running) and
# run `ember-gpu nouveau`. Do one of them BEFORE upgrading a kernel.
#
# SPDX-License-Identifier: GPL-2.0-or-later
set -eu

CONF=/etc/ember/gpu
STATE=/run/ember-gpu
P=/opt/x11-19

usage() { sed -n '3,45p' "$0"; exit "${1:-0}"; }

# ⚠ /sys/module, NEVER lsmod. See above: once nvidia.ko is loaded, reading
# /proc/modules takes the machine down, and lsmod is exactly that read.
loaded() { [ -d "/sys/module/$1" ]; }

status() {
    running=$(cat "$STATE" 2>/dev/null || echo "unknown")
    configured=$(cat "$CONF" 2>/dev/null || echo auto)
    echo "running now:    $running"
    echo "configured:     $configured"
    echo "would detect:   $(/usr/bin/ember-gpu-detect 2>/dev/null || echo '?')"
    echo "kernel module:  $(loaded nvidia && echo "nvidia $(cat /sys/module/nvidia/version 2>/dev/null)" \
                            || (loaded nouveau && echo nouveau \
                            || (loaded radeon && echo radeon \
                            || (loaded amdgpu && echo amdgpu \
                            || (loaded i915 && echo i915 || echo none)))))"
    echo "304 stack:      $([ -f $P/nvidia.ko ] && echo "installed at $P" || echo "not in this image")"
    if loaded nvidia; then
        echo
        echo "⛔ /proc/modules is ARMED — do not run lsmod, do not run dracut."
        echo "   Before a kernel upgrade: ember-gpu nouveau, then reboot."
    fi
}

# ⛔ THE DRIVER CHOICE LIVES ON THE KERNEL COMMAND LINE, NOT IN A BOOT SCRIPT.
# 304 cannot initialise a card nouveau has already programmed -- it fails with
# RmInitAdapter and /dev/nvidia0 returns EIO -- and by the time any script in
# runit stage 1 runs, nouveau is already up from the initramfs. So selecting the
# proprietary driver means editing GRUB and rebooting; there is no runtime path
# that works, and the previous version's `rmmod nouveau; insmod nvidia` left the
# machine with no display at all.
BLACKLIST="rd.driver.blacklist=nouveau modprobe.blacklist=nouveau"

grub_set() {   # $1 = want blacklist? yes|no
    [ -f /etc/default/grub ] || { echo "  (no /etc/default/grub -- live medium? use the boot menu)"; return 0; }
    command -v grub-mkconfig >/dev/null || { echo "  (grub-mkconfig missing, not updating the bootloader)"; return 0; }
    # strip any existing copy, then re-add if wanted, so this is idempotent
    sed -i "s/ *rd\.driver\.blacklist=nouveau//g; s/ *modprobe\.blacklist=nouveau//g" /etc/default/grub
    if [ "$1" = yes ]; then
        if grep -q '^GRUB_CMDLINE_LINUX=' /etc/default/grub; then
            sed -i "s|^GRUB_CMDLINE_LINUX=\"|&$BLACKLIST |" /etc/default/grub
        else
            echo "GRUB_CMDLINE_LINUX=\"$BLACKLIST\"" >> /etc/default/grub
        fi
    fi
    echo "  updating the bootloader..."
    # ⚠ grub-mkconfig does NOT invoke dracut, so it is safe to run with nvidia.ko
    # loaded. Anything that DOES run dracut is not.
    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 \
        || { echo "  ⚠ grub-mkconfig failed; the boot line was NOT updated" >&2; return 1; }
    if [ "$1" = yes ]; then
        grep -q "rd.driver.blacklist=nouveau" /boot/grub/grub.cfg \
            || { echo "  ⚠ the blacklist did not reach grub.cfg" >&2; return 1; }
        echo "  nouveau is blacklisted from the next boot"
    else
        echo "  nouveau will load normally from the next boot"
    fi
}

set_mode() {
    [ "$(id -u)" = 0 ] || { echo "ember-gpu: run me as root" >&2; exit 1; }
    mkdir -p "$(dirname "$CONF")"
    printf '%s\n' "$1" > "$CONF"
    echo "configured: $1"
    case "$1" in
        nvidia|nvidia304) grub_set yes ;;
        *)                grub_set no  ;;
    esac
    now=$(/usr/bin/ember-gpu-detect 2>/dev/null || echo '?')
    echo "next boot will use: $now"
    if [ "$now" != "$(cat "$STATE" 2>/dev/null || echo)" ]; then
        echo
        echo "That differs from what is running. Reboot to apply it —"
        echo "the X server, the kernel module and the console state all have to"
        echo "change together, and only a boot does that cleanly."
    fi
}

case "${1:-status}" in
    status|"")                 status ;;
    auto|nvidia|nvidia304|nouveau|radeon|intel|modesetting) set_mode "$1" ;;
    -h|--help)                 usage 0 ;;
    *) echo "ember-gpu: unknown mode '$1'" >&2; usage 2 ;;
esac

#!/bin/sh
#
# ember-gpu-apply — put the kernel side of the graphics stack into the state
# ember-gpu-detect asked for, then record what actually happened in
# /run/ember-gpu for ember-xserver to read.
#
# ⛔ WHAT IS RECORDED IS WHAT SUCCEEDED, NOT WHAT WAS WANTED. If 304 is asked
# for and the module will not load, this falls back to nouveau AND SAYS SO in
# /run/ember-gpu, so the X wrapper starts the server that matches the driver the
# kernel is actually running. Recording the intention instead would start the
# 1.19 server against nouveau, which is a black screen.
#
# ⚠ Runs from 08-ember-gpu.sh in runit stage 1, before lightdm.
#
# SPDX-License-Identifier: GPL-2.0-or-later
set -eu

STATE=/run/ember-gpu
LOG=/run/ember-gpu.log
P=/opt/x11-19
KO=$P/nvidia.ko

log() { echo "$*" >> "$LOG" 2>/dev/null || true; }
loaded() { [ -d "/sys/module/$1" ]; }

want=$(/usr/bin/ember-gpu-detect 2>/dev/null || echo nouveau)
log "ember-gpu-apply: requested $want"

if [ "$want" != nvidia304 ]; then
    echo "$want" > "$STATE"
    log "ember-gpu-apply: leaving the in-kernel driver alone ($want)"
    exit 0
fi

# ── the proprietary path ────────────────────────────────────────────────────
fallback() {
    log "ember-gpu-apply: FALLING BACK to nouveau -- $1"
    # ⛔ A PLAIN modprobe CAN BE REFUSED ON THE PATH THAT NEEDS THIS MOST. The
    # proprietary boot carries modprobe.blacklist=nouveau, so if the fallback
    # fires there, modprobe may be blocked -- leaving no driver at all, which is
    # the dead screen this exists to prevent. insmod by path bypasses it.
    if ! loaded nouveau; then
        modprobe nouveau 2>>"$LOG" \
            || { NKO=$(modinfo -n nouveau 2>/dev/null); \
                 [ -n "$NKO" ] && insmod "$NKO" 2>>"$LOG"; } \
            || log "ember-gpu-apply: could not load nouveau either -- no driver"
    fi
    # ⚠ Rebind the framebuffer console. Unloading nouveau may have unbound it,
    # and a fallback that leaves a blank console is only half a recovery.
    for v in /sys/class/vtconsole/vtcon*; do
        [ -w "$v/bind" ] || continue
        case "$(cat "$v/name" 2>/dev/null || echo)" in
            *frame\ buffer*) echo 1 > "$v/bind" 2>/dev/null || true ;;
        esac
    done
    echo nouveau > "$STATE"
    exit 0
}

[ -f "$KO" ] || fallback "no $KO in this image"

if loaded nvidia; then
    log "ember-gpu-apply: nvidia already loaded"
    echo nvidia304 > "$STATE"
    exit 0
fi

# ⛔ nouveau MUST NEVER HAVE TOUCHED THIS CARD, AND UNLOADING IT IS NOT ENOUGH.
# The previous version did `rmmod nouveau; insmod nvidia` here, and it produced a
# machine with no display at all. Measured on the reference GeForce 7600 AGP:
#
#     nouveau: [drm] fb0: nouveaudrmfb frame buffer device
#     nouveau: fifo: CACHE_ERROR - ch 0 [systemd-udevd] subc 4 mthd 0000
#     NVRM: loading NVIDIA UNIX x86 Kernel Module 304.137
#     NVRM: RmInitAdapter failed! (0x23:0xffffffff:681)
#     NVIDIA: could not open the device file /dev/nvidia0 (Input/output error)
#     (EE) no screens found
#
# nouveau initialises the card out of the initramfs, errors on it, and 304 then
# cannot re-initialise what it is handed -- it cannot even read the video BIOS.
# On the same machine booted with nouveau blacklisted, 304 loads with no NVRM
# error at all and X comes straight up.
#
# ⛔ SO THE CHOICE BELONGS ON THE KERNEL COMMAND LINE, NOT HERE. By the time
# runit stage 1 runs, the damage is done. The proprietary path requires
#
#     rd.driver.blacklist=nouveau modprobe.blacklist=nouveau ember.gpu=nvidia
#
# which the ISO offers as a menu entry and `ember-gpu nvidia` writes into GRUB.
# If nouveau is loaded when we get here, that did not happen -- and taking the
# card off it anyway is what left a dead screen, so refuse and stay on nouveau.
if loaded nouveau; then
    log "ember-gpu-apply: nouveau is already bound to the card"
    log "  304 cannot take over a GPU nouveau has initialised (RmInitAdapter fails)."
    log "  Boot with rd.driver.blacklist=nouveau modprobe.blacklist=nouveau to use it."
    fallback "nouveau was not blacklisted on the kernel command line"
fi

# ⚠ CHECK VERMAGIC FIRST so a kernel upgrade explains itself. nvidia.ko is built
# against one specific kernel; after an upgrade insmod fails with nothing but
# "Invalid module format", and the machine quietly comes up on nouveau with no
# hint as to why. This is not fatal -- the fallback handles it -- but the log
# should say what happened.
KO_VM=$(modinfo -F vermagic "$KO" 2>/dev/null | awk '{print $1}')
if [ -n "$KO_VM" ] && [ "$KO_VM" != "$(uname -r)" ]; then
    log "ember-gpu-apply: nvidia.ko was built for $KO_VM, running $(uname -r)"
    fallback "the 304 module does not match this kernel (rebuild with build/mk-nvidia304.sh)"
fi
insmod "$KO" 2>>"$LOG" || fallback "insmod $KO failed"
loaded nvidia || fallback "nvidia.ko loaded but /sys/module/nvidia is absent"


# ⚠ 304 predates the driver creating its own nodes reliably, and there is no
# nvidia-modprobe in this image. Missing nodes present as an X server that
# starts, finds no device and exits -- which reads exactly like an unsupported
# card. Cheap to just ensure them.
[ -e /dev/nvidiactl ] || mknod -m 666 /dev/nvidiactl c 195 255 2>/dev/null || true
[ -e /dev/nvidia0 ]   || mknod -m 666 /dev/nvidia0   c 195 0   2>/dev/null || true

# ⛔ RE-RUN udev NOW THAT nvidia IS BOUND, or seat0 stays non-graphical and
# lightdm never starts X. 71-ember-nvidia-seat.rules matches DRIVER=="nvidia",
# which was not true when udev first walked the PCI bus at boot.
udevadm control --reload-rules 2>>"$LOG" || true
udevadm trigger --subsystem-match=pci --action=change 2>>"$LOG" || true
udevadm settle --timeout=10 2>>"$LOG" || true
# ⚠ Not asking loginctl here: elogind is not running yet in stage 1, so the
# answer is always empty and the log line reads like a fault.
log "ember-gpu-apply: udev re-triggered for the nvidia seat tag"

# ⛔ CHECK THE DEVICE OPENS, DO NOT TRY TO "PROBE" THE X SERVER. This used to
# run `Xorg -probeonly`, and that option does not exist in xorg-server 1.19 --
# it is an XFree86 relic. The server exited with "Unrecognized option:
# -probeonly", the guard read that as the card failing, and a perfectly working
# GPU was thrown back to nouveau on every single boot. A guard that fails closed
# on its own bug is worse than no guard.
#
# ⚠ Test the thing that actually broke: when the GPU has not initialised, NVRM
# logs RmInitAdapter failed and opening /dev/nvidia0 returns EIO -- which is
# exactly what the X server hits and reports as "no screens found".
#
# ⚠ AND THE STAKES ARE LOWER NOW. This was written when the proprietary path
# unloaded nouveau and took the framebuffer console with it, so a failure meant
# no console and no X. With nouveau blacklisted from the kernel command line the
# console is plain VGA text and survives, so the fallback is a convenience
# rather than the only way back in.
if ! (exec 3< /dev/nvidia0) 2>>"$LOG"; then
    log "ember-gpu-apply: /dev/nvidia0 will not open -- the GPU did not initialise"
    dmesg 2>/dev/null | grep -iE "NVRM|RmInit" | tail -5 >> "$LOG" 2>/dev/null || true
    rmmod nvidia 2>>"$LOG" || true
    fallback "the NVIDIA GPU did not initialise (see NVRM messages above)"
fi
log "ember-gpu-apply: /dev/nvidia0 opens, GPU initialised"

echo nvidia304 > "$STATE"
log "ember-gpu-apply: nvidia $(cat /sys/module/nvidia/version 2>/dev/null || echo '?') loaded"

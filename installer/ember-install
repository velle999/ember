#!/bin/bash
#
# ember-install — put the running system into unallocated space, beside an
# existing OS, without touching it.
#
# ── The rule this whole script is built around ──────────────────────────────
#
# ⛔ IT NEVER WRITES INSIDE AN EXISTING PARTITION. It creates one partition in
# free space, formats that, and installs a bootloader. Every destructive step is
# fenced by a check that the target is unallocated, and the partition table is
# read back and compared afterwards to prove nothing else moved.
#
# ⚠ THE ONE THING IT DOES TOUCH IS THE MBR, because a bootloader has to live
# there for the BIOS to find it. So the MBR and the partition table are BACKED
# UP FIRST, to two places, and the restore command is printed. Restoring the old
# boot sector puts the machine back exactly as it was.
#
# ⚠ Windows XP is the case this was written for: MBR, BIOS, NTFS, and an
# expectation that its own boot sector is where it left it. Nothing here moves,
# resizes or writes to an NTFS partition.
#
# Usage:
#   ember-install --plan            # show the disk, the free space and the plan
#   ember-install /dev/sda          # do it, with a confirmation prompt
#   ember-install --yes /dev/sda    # no prompt (for the test rig)
#
#   ember-install --reuse           # REINSTALL over the existing Ember partition
#   ember-install --reuse /dev/sda2 # ...naming it explicitly
#
# ⛔ --reuse REFORMATS A PARTITION THAT ALREADY EXISTS, so it only ever accepts
# one that is provably a previous Ember install: an ext4 filesystem whose LABEL
# is this system's. Anything else — NTFS, unlabelled, another distribution — is
# refused, because "install over the same partition" and "install over the
# partition next to it" differ by one keystroke and one of them is somebody's
# Windows. --force-reuse overrides that check and asks a second time, in words.
#
# SPDX-License-Identifier: GPL-2.0-or-later
set -euo pipefail

PLAN_ONLY=0; ASSUME_YES=0; DISK=""; REUSE=0; REUSE_PART=""; FORCE_REUSE=0
while [ $# -gt 0 ]; do
    case "$1" in
        --plan) PLAN_ONLY=1 ;;
        --yes|-y) ASSUME_YES=1 ;;
        --reuse) REUSE=1
                 case "${2:-}" in /dev/*) REUSE_PART=$2; shift ;; esac ;;
        --force-reuse) REUSE=1; FORCE_REUSE=1
                 case "${2:-}" in /dev/*) REUSE_PART=$2; shift ;; esac ;;
        -h|--help) sed -n '2,32p' "$0"; exit 0 ;;
        /dev/*) DISK=$1 ;;
        *) echo "ember-install: unknown argument $1" >&2; exit 2 ;;
    esac
    shift
done

# The filesystem label is how a later run recognises its own install. It is a
# constant rather than a hostname so that renaming the machine does not make the
# reinstall path stop recognising the partition it created.
EMBER_LABEL=ember
EMBER_NAME=Ember

[ "$(id -u)" = 0 ] || { echo "ember-install: run me as root" >&2; exit 1; }
for t in parted sfdisk mkfs.ext4 rsync grub-install grub-mkconfig blkid lsblk; do
    command -v "$t" >/dev/null || { echo "ember-install: $t is missing" >&2; exit 1; }
done

# ── pick the disk ───────────────────────────────────────────────────────────
if [ -z "$DISK" ]; then
    # The biggest non-removable disk. Removable is excluded on purpose: the
    # system is very likely running FROM a USB stick right now, and offering to
    # install onto the thing you booted off is how people lose an afternoon.
    DISK=$(lsblk -dnro NAME,SIZE,RM,TYPE | awk '$3=="0" && $4=="disk" {print "/dev/"$1}' | head -1)
fi
[ -b "$DISK" ] || { echo "ember-install: $DISK is not a block device" >&2; exit 1; }

echo "== target disk: $DISK"
lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS "$DISK" | sed 's/^/   /'
echo

LABEL_TYPE=$(parted -sm "$DISK" print 2>/dev/null | awk -F: 'NR==2 {print $6}')
echo "   partition table: ${LABEL_TYPE:-unknown}"
if [ "$LABEL_TYPE" != msdos ]; then
    echo "ember-install: this disk is '$LABEL_TYPE', not msdos/MBR." >&2
    echo "               Windows XP requires MBR, so this is not the disk XP is on," >&2
    echo "               or something has changed. Refusing rather than guessing." >&2
    exit 1
fi

# ⛔ FOUR PRIMARIES IS THE MBR'S HARD LIMIT and there is no way round it here.
# Better to say so than to have parted fail halfway through a partition table
# rewrite on the disk holding somebody's XP install.
nprim=$(parted -sm "$DISK" print 2>/dev/null | awk -F: 'NR>2 && $1 ~ /^[0-9]+$/ {n++} END {print n+0}')
echo "   existing partitions: $nprim"
if [ "$nprim" -ge 4 ]; then
    echo "ember-install: the MBR already holds 4 partitions, its hard limit." >&2
    echo "               Nothing can be added without deleting one. Refusing." >&2
    exit 1
fi

# ── reinstalling over an existing Ember partition ───────────────────────────
#
# This is the second-install case: the free space was consumed the first time,
# so there is nothing left to carve and the intent is to replace what is there.
if [ "$REUSE" = 1 ]; then
    if [ -z "$REUSE_PART" ]; then
        # Every ext4 partition on this disk labelled as ours. Auto-detection is
        # deliberately narrow — it will not guess at an unlabelled partition.
        # ⛔ -c /dev/null ON EVERY blkid CALL, or the cache answers instead of the
        # disk. A partition created during this very boot is not in
        # /run/blkid/blkid.tab, so cached blkid reports it as having no
        # filesystem at all — which is exactly how a freshly made ext4 labelled
        # `ember` was invisible to the code looking for an ext4 labelled `ember`.
        #
        # ⛔ blkid, NOT lsblk. lsblk's FSTYPE and LABEL columns come from udev,
        # and in a freshly booted minimal system — or right after a partition is
        # created — they are simply EMPTY. Auto-detection then finds nothing and
        # says there is no previous install, on a disk that plainly has one.
        # blkid probes the device itself and always answers.
        mapfile -t CANDS < <(
            for part in $(lsblk -pnro NAME,TYPE "$DISK" | awk '$2=="part" {print $1}'); do
                [ "$(blkid -c /dev/null -s TYPE  -o value "$part" 2>/dev/null)" = ext4 ] || continue
                [ "$(blkid -c /dev/null -s LABEL -o value "$part" 2>/dev/null)" = "$EMBER_LABEL" ] || continue
                echo "$part"
            done)
        case "${#CANDS[@]}" in
            0) echo "ember-install: no existing $EMBER_LABEL partition found on $DISK." >&2
               lsblk -o NAME,SIZE,FSTYPE,LABEL "$DISK" | sed 's/^/  /' >&2
               echo "               Name one explicitly if you know which it is." >&2
               exit 1 ;;
            1) REUSE_PART=${CANDS[0]} ;;
            *) echo "ember-install: ${#CANDS[@]} partitions labelled $EMBER_LABEL — name one." >&2
               printf '               %s\n' "${CANDS[@]}" >&2
               exit 1 ;;
        esac
    fi
    [ -b "$REUSE_PART" ] || { echo "ember-install: $REUSE_PART is not a block device" >&2; exit 1; }

    # Same reason as above: probe, do not ask udev.
    RFS=$(blkid -c /dev/null -s TYPE  -o value "$REUSE_PART" 2>/dev/null || true)
    RLABEL=$(blkid -c /dev/null -s LABEL -o value "$REUSE_PART" 2>/dev/null || true)
    RSIZE_MB=$(( $(blockdev --getsize64 "$REUSE_PART") / 1024 / 1024 ))
    NEEDED=$(( $(du -sm --one-file-system / | cut -f1) + 512 ))

    echo "   reinstall target: $REUSE_PART  (${RSIZE_MB} MiB, ${RFS:-no filesystem}, label '${RLABEL:-none}')"
    echo "   this system needs: ${NEEDED} MiB"

    # ⛔ THE GUARD. Only a partition that is already ours may be reformatted.
    if [ "$RLABEL" != "$EMBER_LABEL" ] || [ "$RFS" != ext4 ]; then
        if [ "$FORCE_REUSE" != 1 ]; then
            echo "ember-install: $REUSE_PART is not a previous $EMBER_NAME install." >&2
            echo "               It is '${RFS:-unformatted}' labelled '${RLABEL:-none}';" >&2
            echo "               expected ext4 labelled '$EMBER_LABEL'. REFUSING." >&2
            echo "               If you are certain, --force-reuse says so explicitly." >&2
            exit 1
        fi
        FORCED_NOTE="   ⛔ FORCED: this is NOT a previous $EMBER_NAME install."
    fi

    if [ "$RSIZE_MB" -lt "$NEEDED" ]; then
        echo "ember-install: $REUSE_PART is ${RSIZE_MB} MiB; ${NEEDED} MiB is needed." >&2
        exit 1
    fi

    # ⚠ Mounted is refused rather than unmounted for you: if it is mounted it may
    # be in use, and on a live USB the one partition you must never reformat is
    # the one you are running from.
    if findmnt -n -S "$REUSE_PART" >/dev/null 2>&1; then
        echo "ember-install: $REUSE_PART is mounted at $(findmnt -no TARGET -S "$REUSE_PART")." >&2
        echo "               Refusing. If that is the system you booted, you cannot" >&2
        echo "               reinstall over it from inside itself." >&2
        exit 1
    fi

    cat <<PLAN

   PLAN (reinstall)
     · REFORMAT $REUSE_PART — everything on it is destroyed
     · copy this running system onto it
     · back up the MBR and the partition table, then install GRUB to $DISK
     · enable os-prober so the existing OS gets its own menu entry
${FORCED_NOTE:-}

   NOT TOUCHED: the partition table itself, and every other partition on $DISK.

PLAN

    [ "$PLAN_ONLY" = 1 ] && exit 0
    if [ "$ASSUME_YES" != 1 ]; then
        printf '   Type REINSTALL to proceed: '
        read -r reply
        [ "$reply" = REINSTALL ] || { echo "   aborted."; exit 1; }
        if [ "${FORCED_NOTE:-}" != "" ]; then
            printf '   You are overwriting something that is NOT %s. Type I UNDERSTAND: ' "$EMBER_NAME"
            read -r reply2
            [ "$reply2" = "I UNDERSTAND" ] || { echo "   aborted."; exit 1; }
        fi
    fi

    BK=/root/ember-install-backup
    mkdir -p "$BK"
    dd if="$DISK" of="$BK/mbr.bin" bs=512 count=1 status=none
    sfdisk -d "$DISK" > "$BK/partition-table.sfdisk" 2>/dev/null || true
    echo "   backed up the MBR and partition table to $BK"

    NEWPART="$REUSE_PART"
    REUSING=1
else
    REUSING=0
fi

if [ "$REUSING" = 0 ]; then
# ── find the free space ─────────────────────────────────────────────────────
# parted reports unallocated regions as 'free' entries; the largest is taken.
read -r FREE_START FREE_END FREE_SIZE <<EOF
$(parted -sm "$DISK" unit MiB print free 2>/dev/null |
  awk -F: '$5=="free;" {gsub(/MiB/,"",$2); gsub(/MiB/,"",$3); gsub(/MiB/,"",$4);
                        if ($4+0 > m) {m=$4+0; s=$2; e=$3}}
           END {printf "%d %d %d", s, e, m}')
EOF
NEEDED=$(( $(du -sm --one-file-system / | cut -f1) + 1024 ))

echo "   largest free region: ${FREE_SIZE} MiB  (${FREE_START} MiB → ${FREE_END} MiB)"
echo "   this system needs:   ${NEEDED} MiB"

# ⚠ Aligned to the next MiB boundary. XP-era tables start partitions at sector
# 63 for CHS reasons; a modern partition placed on a MiB boundary next to one of
# those is fine, and misaligning to "match" it would only cost performance.
#
# ⛔ AND THE END IS ONE MiB SHORT OF WHAT parted REPORTS. `print free` gives the
# last boundary of the region, which for the final region IS the end of the
# disk — and passing that straight to mkpart fails with "The location 12288MiB
# is outside of the device". Found by build/install-test.sh, which is exactly
# the failure that would otherwise have happened on somebody's real disk halfway
# through an install, after the MBR backup and before anything useful.
START=$(( FREE_START + 1 ))
END=$(( FREE_END - 1 ))
USABLE=$(( END - START ))

# Checked against the range actually being asked for, not the raw region: those
# differ by the two MiB trimmed above, and a check on the wrong one passes a
# build that then fails at mkpart.
if [ "${USABLE:-0}" -lt "$NEEDED" ]; then
    echo "ember-install: not enough unallocated space — ${USABLE} MiB usable, ${NEEDED} MiB needed." >&2
    exit 1
fi

cat <<PLAN

   PLAN
     · create ONE new primary partition, ${START} MiB → ${END} MiB
     · format it ext4, label "$(hostname)"
     · copy this running system onto it
     · back up the MBR and the partition table, then install GRUB to $DISK
     · enable os-prober so the existing OS gets its own menu entry

   NOT TOUCHED: every existing partition, and every byte inside them.

PLAN

[ "$PLAN_ONLY" = 1 ] && exit 0

if [ "$ASSUME_YES" != 1 ]; then
    printf '   Type INSTALL to proceed: '
    read -r reply
    [ "$reply" = INSTALL ] || { echo "   aborted."; exit 1; }
fi

# ── back up before anything is written ──────────────────────────────────────
BK=/root/ember-install-backup
mkdir -p "$BK"
dd if="$DISK" of="$BK/mbr.bin" bs=512 count=1 status=none
sfdisk -d "$DISK" > "$BK/partition-table.sfdisk" 2>/dev/null || true
BEFORE_TABLE=$(sfdisk -d "$DISK" 2>/dev/null | grep -v '^label-id' || true)
echo "   backed up the MBR and partition table to $BK"

# ── the new partition ───────────────────────────────────────────────────────
parted -s "$DISK" mkpart primary ext4 "${START}MiB" "${END}MiB"
partprobe "$DISK" 2>/dev/null || true
command -v udevadm >/dev/null && udevadm settle --timeout=15 2>/dev/null || true

NEWNUM=$(parted -sm "$DISK" print 2>/dev/null | awk -F: 'NR>2 && $1 ~ /^[0-9]+$/ {n=$1} END {print n}')

# ⛔ THE DEVICE NODE APPEARS ASYNCHRONOUSLY. parted returns as soon as the table
# is written; the kernel and udev create /dev/sdb2 a moment later, and how long
# that takes varies with the disk and the machine. This was `sleep 2` and it was
# not enough — the installer stopped at "cannot find the new partition" having
# already written the partition table, which is the worst possible place to give
# up: the disk is modified and nothing is installed. Waited for properly now,
# with the timeout stated rather than guessed at.
NEWPART=""
for _ in $(seq 1 60); do
    for cand in "${DISK}${NEWNUM}" "${DISK}p${NEWNUM}"; do
        [ -b "$cand" ] && { NEWPART="$cand"; break 2; }
    done
    sleep 0.5
done
if [ -z "$NEWPART" ]; then
    echo "ember-install: the partition was created but its device node never" >&2
    echo "               appeared after 30s. The table IS modified; restore with:" >&2
    echo "               dd if=$BK/mbr.bin of=$DISK bs=512 count=1" >&2
    exit 1
fi
echo "   created $NEWPART"

# ⛔ THE PROOF THAT NOTHING ELSE MOVED. Every line of the old table must still be
# present in the new one; the only permitted difference is the added partition.
AFTER_TABLE=$(sfdisk -d "$DISK" 2>/dev/null | grep -v '^label-id' || true)
missing=0
while IFS= read -r line; do
    case "$line" in ""|label*|device*|unit*|sector-size*|first-lba*|last-lba*|grain*) continue ;; esac
    printf '%s\n' "$AFTER_TABLE" | grep -qF -- "$line" || { echo "   CHANGED: $line" >&2; missing=1; }
done <<< "$BEFORE_TABLE"
if [ "$missing" = 1 ]; then
    echo "ember-install: an existing partition entry changed. STOPPING." >&2
    echo "               Restore with: dd if=$BK/mbr.bin of=$DISK bs=512 count=1" >&2
    exit 1
fi
echo "   verified: every pre-existing partition entry is unchanged"
fi   # end of the create-a-new-partition path; both paths meet here

# ⚠ THE LABEL IS LOAD-BEARING, not decoration: it is the only thing that lets a
# later --reuse recognise this partition as ours rather than as somebody's data.
#
# ⛔ -F BECAUSE CONSENT WAS ALREADY TAKEN, and without it a reinstall HANGS.
# mkfs.ext4 finds the previous filesystem, asks "Proceed anyway? (y,N)" and
# waits — on an unattended run that is a stall with no output, and the operator
# has already typed REINSTALL in full to a plan that said the partition would be
# reformatted. Asking twice is not more careful, it is just stuck.
mkfs.ext4 -F -q -O ^metadata_csum_seed,^orphan_file -L "$EMBER_LABEL" "$NEWPART"
MNT=$(mktemp -d)
mount "$NEWPART" "$MNT"

echo "   copying the system (this takes a while)"
rsync -aHAXx --info=progress2 \
      --exclude=/proc/ --exclude=/sys/ --exclude=/dev/ --exclude=/run/ \
      --exclude=/tmp/ --exclude=/mnt/ --exclude=/media/ --exclude="$MNT" \
      / "$MNT/"
mkdir -p "$MNT"/{proc,sys,dev,run,tmp,mnt,media}
chmod 1777 "$MNT/tmp"

UUID=$(blkid -s UUID -o value "$NEWPART")
printf 'UUID=%s\t/\text4\tdefaults,noatime\t0 1\n' "$UUID" > "$MNT/etc/fstab"
cp -a "$BK" "$MNT/root/" 2>/dev/null || true

for d in dev proc sys; do mount --bind "/$d" "$MNT/$d"; done

# ⛔ os-prober MUST BE TURNED ON EXPLICITLY. Modern GRUB disables it by default
# — our own build log says so: "Warning: os-prober will not be executed to
# detect other bootable partitions." Leaving it off produces a grub.cfg with no
# Windows entry, which does not look like a failure. It looks like XP is gone.
sed -i '/^GRUB_DISABLE_OS_PROBER=/d' "$MNT/etc/default/grub"
echo 'GRUB_DISABLE_OS_PROBER=false' >> "$MNT/etc/default/grub"

chroot "$MNT" /bin/bash -euc "
    dracut --force --no-hostonly
    grub-install --target=i386-pc --boot-directory=/boot --recheck '$DISK'
    grub-mkconfig -o /boot/grub/grub.cfg
"

# ── did the other OS survive into the menu? ─────────────────────────────────
others=$(grep -ciE "windows|microsoft" "$MNT/boot/grub/grub.cfg" || true)
if [ "$others" -gt 0 ]; then
    echo "   os-prober found the existing OS — $others menu entr(y|ies) for it"
else
    echo
    echo "   ⚠ NO WINDOWS ENTRY IN THE BOOT MENU." >&2
    echo "     The install is fine and XP's partition is untouched, but GRUB did" >&2
    echo "     not detect it. Usually ntfs-3g is missing or the NTFS partition is" >&2
    echo "     unclean (XP hibernated or fast-shut-down leaves it dirty)." >&2
    echo "     Boot XP once, shut it down fully, then re-run:  grub-mkconfig -o /boot/grub/grub.cfg" >&2
    echo "     To get XP back immediately:  dd if=$BK/mbr.bin of=$DISK bs=512 count=1" >&2
fi

for d in dev proc sys; do umount "$MNT/$d" 2>/dev/null || true; done
umount "$MNT"; rmdir "$MNT"
sync

cat <<DONE

   Installed to $NEWPART (UUID $UUID).
   The old boot sector is saved at $BK/mbr.bin — to undo the bootloader
   change entirely and go straight back to XP:

       dd if=$BK/mbr.bin of=$DISK bs=512 count=1

DONE
